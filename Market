name: market-data

on:
  schedule:
    - cron: '*/10 * * * *'   # 10분마다 (GitHub 사정으로 몇 분 늦어질 수 있어요)
  workflow_dispatch:          # 수동 실행 버튼

permissions:
  contents: write

concurrency:
  group: market-data
  cancel-in-progress: true

jobs:
  update:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: 이전 데이터 받아오기 (실패해도 무시)
        run: curl -fsSL "https://raw.githubusercontent.com/${{ github.repository }}/market-data/market.json" -o prev.json || true

      - name: 시세 수집
        env:
          PREV_FILE: prev.json
          OUT_FILE: market.json
        run: node collect.mjs

      - name: market-data 브랜치로 게시 (기록은 1개만 유지)
        run: |
          mkdir -p /tmp/out && cp market.json /tmp/out/market.json
          cd /tmp/out
          git init -q -b market-data
          git config user.name "market-bot"
          git config user.email "market-bot@users.noreply.github.com"
          git add market.json
          git commit -q -m "update $(date -u +%FT%TZ)"
          git push -f "https://x-access-token:${{ secrets.GITHUB_TOKEN }}@github.com/${{ github.repository }}.git" market-data
